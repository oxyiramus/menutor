server {
    listen 80;
    listen 443 ssl;
    server_name menutor.example.com;

    ssl_certificate /etc/letsencrypt/live/menutor.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/menutor.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        include /etc/nginx/menutor/proxy-key.conf;
    }
}
