POSTGRES_USER=zhdanova
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=menutor_db
JWT_SECRET_KEY=some_awesome_key
API_URL=http://localhost:8000
ACCESS_TOKEN_MINUTES=30
# Разрешённые origins через запятую, например https://app.example,https://admin.example.
# Пустое значение отключает CORS-разрешения. Для same-origin UI настройка не нужна.
# Указывайте схему, хост и при необходимости порт. Wildcard и null запрещены.
# Переменная процесса имеет приоритет. Backend читает настройку при запуске.
CORS_ALLOWED_ORIGINS=
GITHUB_TOKEN=

MODELS_PATH=
MIGRATION_PATH=
DEPENDENCIES_CFG_PATH=pyproject.toml
